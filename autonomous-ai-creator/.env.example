# Server Port
PORT=3001

# AI Provider Settings (Default: mock)
# Options: mock, gemini, openai, anthropic
AI_PROVIDER=mock

# Optional API Keys (Leave blank to use intelligent built-in Mock provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Safety & Autonomous Execution Limits
MAX_ITERATIONS=25
MAX_RETRIES=3
MAX_EXECUTION_TIME_SEC=600
DEFAULT_TOKEN_BUDGET=100000
REQUIRE_APPROVAL_DEFAULT=true
